---
import "../styles/global.css";
import { site } from "../data/site";

type Props = {
  title?: string;
  description?: string;
};

const title = Astro.props.title ?? site.title;
const description = Astro.props.description ?? site.description;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <title>{title}</title>
  </head>
  <body>
    <header
      class="sticky top-0 z-10 border-b border-rule bg-paper/85 backdrop-blur-md"
    >
      <div
        class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-5 py-3"
      >
        <a href="#top" class="mono text-sm text-ink no-underline hover:text-accent"
          >{site.name}</a
        >
        <nav class="mono flex flex-wrap gap-x-4 gap-y-1 text-xs text-mute">
          <a href="#work">Work</a>
          <a href="#loop">Loop</a>
          <a href="#activity">GitHub</a>
          <a href="#contact">Contact</a>
        </nav>
      </div>
    </header>
    <div class="mx-auto max-w-5xl px-5 py-12 sm:py-16">
      <slot />
    </div>
  </body>
</html>
