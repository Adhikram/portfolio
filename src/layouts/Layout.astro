---
import "../styles/global.css";
import WorkTrain from "../components/WorkTrain.astro";
import { site } from "../data/site";

type Props = {
  title?: string;
  description?: string;
  image?: string;
};

const title = Astro.props.title ?? site.title;
const description = Astro.props.description ?? site.description;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const imagePath =
  Astro.props.image && !Astro.props.image.endsWith(".svg")
    ? Astro.props.image
    : "/og.png";
const image = new URL(imagePath, Astro.site).toString();
const isHome = Astro.url.pathname === "/";
const jsonLd = isHome
  ? {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebSite",
          name: site.name,
          url: Astro.site?.toString() ?? "https://adhikram.com/",
          description,
        },
        {
          "@type": "Person",
          name: site.name,
          url: Astro.site?.toString() ?? "https://adhikram.com/",
          email: site.email,
          jobTitle: "Founding engineer",
          description,
          image,
          sameAs: [site.github, site.linkedin, site.twitter],
          address: {
            "@type": "PostalAddress",
            addressCountry: "IN",
          },
        },
      ],
    }
  : {
      "@context": "https://schema.org",
      "@type": "WebPage",
      name: title,
      description,
      url: canonical,
      isPartOf: {
        "@type": "WebSite",
        name: site.name,
        url: Astro.site?.toString() ?? "https://adhikram.com/",
      },
    };
const home = isHome ? "#top" : "/";
const experienceHref = Astro.url.pathname === "/" ? "#work" : "/#work";
const productsHref = Astro.url.pathname === "/" ? "#products" : "/#products";
const aboutHref = Astro.url.pathname === "/" ? "#about" : "/#about";
const githubHref = Astro.url.pathname === "/" ? "#github" : "/#github";
const readingHref = Astro.url.pathname === "/" ? "#reading" : "/#reading";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#0b0c12" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLM profile" />
    <meta name="color-scheme" content="dark light" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={isHome ? "profile" : "website"} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name}, founding engineer`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={`@${site.twitterUser}`} />
    <meta name="twitter:creator" content={`@${site.twitterUser}`} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>
      (function () {
        try {
          var stored = window.localStorage.getItem("theme-preference");
          var theme = stored ? stored : "system";
          if (theme === "system") {
            theme = window.matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "light";
          }
          document.documentElement.classList.add(theme);
          document.documentElement.style.colorScheme = theme;
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a
      href="#main-content"
      class="btn btn-primary absolute left-4 top-4 z-100 -translate-y-20 focus:translate-y-0"
      >Skip to content</a
    >
    <div class="page-frame-outer flex min-h-dvh flex-col">
      <header class="frame-chrome">
        <nav class="site-links" aria-label="Site">
          <a href={home}>
            <svg class="nav-icon" viewBox="0 0 16 16" aria-hidden="true"
              ><path
                fill="currentColor"
                d="M8 1.2 1.5 7.1a.75.75 0 0 0 .96 1.15L3 7.77V13.5A1.5 1.5 0 0 0 4.5 15h7a1.5 1.5 0 0 0 1.5-1.5V7.77l.54.48A.75.75 0 0 0 14.5 7.1L8 1.2ZM5 13.5V8.6l3-2.6 3 2.6v4.9H5Z"
              ></path></svg
            >
            Home
          </a>
          <a href={aboutHref}>
            <svg class="nav-icon" viewBox="0 0 16 16" aria-hidden="true"
              ><path
                fill="currentColor"
                d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm-5.5 6.5a5.5 5.5 0 1 1 11 0 .75.75 0 0 1-.75.75h-9.5a.75.75 0 0 1-.75-.75Z"
              ></path></svg
            >
            About
          </a>
          <a href={experienceHref}>
            <svg class="nav-icon" viewBox="0 0 16 16" aria-hidden="true"
              ><path
                fill="currentColor"
                d="M5.5 3.5A1.5 1.5 0 0 1 7 2h2a1.5 1.5 0 0 1 1.5 1.5V4h2.25A1.75 1.75 0 0 1 14.5 5.75v6.5A1.75 1.75 0 0 1 12.75 14H3.25A1.75 1.75 0 0 1 1.5 12.25v-6.5A1.75 1.75 0 0 1 3.25 4H5.5V3.5ZM7 4h2V3.5a.5.5 0 0 0-.5-.5H7.5a.5.5 0 0 0-.5.5V4Z"
              ></path></svg
            >
            Experience
          </a>
          <a href={productsHref}>
            <svg class="nav-icon" viewBox="0 0 16 16" aria-hidden="true"
              ><path
                fill="currentColor"
                d="M8.38 1.13a1.25 1.25 0 0 0-.76 0L2.37 3.2A1.25 1.25 0 0 0 1.5 4.37v7.26c0 .5.3.95.76 1.16l5.25 2.08c.24.1.5.1.76 0l5.25-2.08a1.25 1.25 0 0 0 .76-1.16V4.37a1.25 1.25 0 0 0-.87-1.17L8.38 1.13ZM3 5.2l4.25 1.68v6.17L3 11.37V5.2Zm6.75 7.85V6.88L14 5.2v6.17l-4.25 1.68Z"
              ></path></svg
            >
            Products
          </a>
          <a href={githubHref}>
            <svg class="nav-icon" viewBox="0 0 16 16" aria-hidden="true"
              ><path
                fill="currentColor"
                d="M8 0C3.58 0 0 3.58 0 8a8.01 8.01 0 0 0 5.47 7.59c.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.7 7.7 0 0 1 4 0c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
              ></path></svg
            >
            GitHub
          </a>
          <a href={readingHref}>
            <svg class="nav-icon" viewBox="0 0 16 16" aria-hidden="true"
              ><path
                fill="currentColor"
                d="M1.75 2.5A.75.75 0 0 1 2.5 1.75h4.07c.84 0 1.64.37 2.18 1.01.54-.64 1.34-1.01 2.18-1.01H15a.75.75 0 0 1 .75.75v10.5a.75.75 0 0 1-.75.75h-4.07a.75.75 0 0 0-.53.22l-.9.9a.75.75 0 0 1-1.06 0l-.9-.9a.75.75 0 0 0-.53-.22H2.5a.75.75 0 0 1-.75-.75V2.5Zm1.5.75v9h3.32c.6 0 1.18.24 1.6.66l.33.33.33-.33a2.25 2.25 0 0 1 1.6-.66h3.32v-9H10.93a.75.75 0 0 0-.75.75v5.5a.75.75 0 0 1-1.5 0v-5.5a.75.75 0 0 0-.75-.75H3.25Z"
              ></path></svg
            >
            Reading
          </a>
        </nav>
        <button
          type="button"
          id="theme-toggle"
          class="theme-toggle"
          aria-label="Toggle color theme"
        >
          <svg class="nav-icon theme-icon-sun" viewBox="0 0 16 16" aria-hidden="true"
            ><path
              fill="currentColor"
              d="M8 11.25A3.25 3.25 0 1 0 8 4.75a3.25 3.25 0 0 0 0 6.5ZM8 1.5a.75.75 0 0 1 .75.75v1a.75.75 0 0 1-1.5 0v-1A.75.75 0 0 1 8 1.5Zm0 11.5a.75.75 0 0 1 .75.75v1a.75.75 0 0 1-1.5 0v-1A.75.75 0 0 1 8 13Zm6.5-5a.75.75 0 0 1-.75.75h-1a.75.75 0 0 1 0-1.5h1a.75.75 0 0 1 .75.75ZM3.25 8A.75.75 0 0 1 2.5 8.75h-1a.75.75 0 0 1 0-1.5h1A.75.75 0 0 1 3.25 8Zm9.07-4.32a.75.75 0 0 1 0 1.06l-.7.7a.75.75 0 1 1-1.06-1.06l.7-.7a.75.75 0 0 1 1.06 0ZM5.44 10.56a.75.75 0 0 1 0 1.06l-.7.7a.75.75 0 1 1-1.06-1.06l.7-.7a.75.75 0 0 1 1.06 0Zm6.12 1.76a.75.75 0 0 1-1.06 0l-.7-.7a.75.75 0 0 1 1.06-1.06l.7.7a.75.75 0 0 1 0 1.06ZM4.74 4.74a.75.75 0 0 1-1.06 0l-.7-.7A.75.75 0 0 1 4.04 3l.7.7a.75.75 0 0 1 0 1.06Z"
            ></path></svg
          >
          <svg class="nav-icon theme-icon-moon" viewBox="0 0 16 16" aria-hidden="true"
            ><path
              fill="currentColor"
              d="M7.05 1.57a.75.75 0 0 1 .2 1.04 5.5 5.5 0 1 0 6.14 6.14.75.75 0 1 1 1.24.84A7 7 0 1 1 6.2 1.37a.75.75 0 0 1 .85.2Z"
            ></path></svg
          >
          Theme
        </button>
      </header>
      <main id="main-content" class="page-frame relative flex-1" tabindex="-1">
        <slot />
      </main>
      <WorkTrain />
    </div>
    <script is:inline>
      document.getElementById("theme-toggle")?.addEventListener("click", function () {
        var root = document.documentElement;
        var next = root.classList.contains("dark") ? "light" : "dark";
        root.classList.remove("light", "dark");
        root.classList.add(next);
        root.style.colorScheme = next;
        try {
          localStorage.setItem("theme-preference", next);
        } catch (e) {}
      });
    </script>
  </body>
</html>
