---
import { markSrc } from "../lib/marks";

type Props = {
  name: string;
  class?: string;
  loading?: "lazy" | "eager";
};

const src = markSrc(Astro.props.name);
const klass = Astro.props.class ?? "mark";
const loading = Astro.props.loading ?? "lazy";
---

{
  src ? (
    <img
      class={klass}
      src={src}
      alt=""
      width="12"
      height="12"
      loading={loading}
      decoding="async"
    />
  ) : null
}
