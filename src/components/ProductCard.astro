---
import type { Product } from "../data/site";

type Props = {
  product: Product;
};

const { product } = Astro.props;
---

<article
  id={product.id}
  class:list={[
    "scroll-mt-24 border border-rule bg-card p-6 sm:p-8",
    product.featured && "sm:col-span-2",
  ]}
>
  <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-2">
    <p class="mono text-xs tracking-wide text-mute uppercase">
      {product.kindLabel} · {product.role}
    </p>
    <p class="mono text-xs text-mute">{product.period}</p>
  </div>

  <h3 class="mt-3 text-2xl font-medium tracking-tight">
    {
      product.url ? (
        <a href={product.url}>{product.name}</a>
      ) : (
        product.name
      )
    }
  </h3>

  <p class="mt-3 leading-7 text-ink/90">{product.summary}</p>

  <dl
    class:list={[
      "mt-6 grid gap-4 border-y border-rule py-4",
      product.metrics.length > 2
        ? "grid-cols-2 sm:grid-cols-3"
        : "grid-cols-2",
    ]}
  >
    {
      product.metrics.map((m) => (
        <div>
          <dt class="mono text-lg font-medium text-ink">{m.value}</dt>
          <dd class="mt-1 text-sm text-mute">{m.label}</dd>
        </div>
      ))
    }
  </dl>

  <ul class="mt-5 space-y-2 text-[0.98rem] leading-7">
    {
      product.shipped.map((line) => (
        <li class="relative pl-4 before:absolute before:left-0 before:text-mute before:content-['-']">
          {line}
        </li>
      ))
    }
  </ul>

  <p class="mono mt-6 flex flex-wrap gap-x-3 gap-y-1 text-xs text-mute">
    {product.stack.map((tag) => <span>{tag}</span>)}
  </p>
</article>
