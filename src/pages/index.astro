---
import Layout from "../layouts/Layout.astro";
import { site, timeline } from "../data/site";
import { fetchRecentPullRequests } from "../lib/github";

const prs = await fetchRecentPullRequests(
  site.githubUser,
  process.env.GITHUB_TOKEN,
);
---

<Layout>
  <header>
    <p class="mono text-sm tracking-wide text-mute">{site.name}</p>
    <h1 class="mt-6 text-[1.65rem] font-medium leading-snug tracking-tight">
      Hey, I am Adhikram
    </h1>
  </header>

  <section class="mt-8 space-y-5 text-[1.05rem] leading-7 text-ink">
    <p>
      I ship production GenAI with operators, not in a vacuum. Forward-deployed
      AI engineer: agentic and RAG systems in customer environments, 5+ years of
      data and backend at scale, founder who took a SaaS from 0 to $20K MRR and
      runs a live GenAI product (<a href={site.techprufer}>TechPrufer</a>).
    </p>
    <p>
      At
      <a href={site.anax}>ANAX</a>
      I sit with brokers and pull real-estate workflows into grounded retrieval
      over 20K+ financial docs. TechPrufer is the public loop: job intel, tailor
      agents, MCP across IDEs, 400+ companies, about 2,000 unique users a day.
    </p>
    <p>
      I will not drown in your data plane.
      <a href={site.mediaNet}>Media.net</a>
      : billions of rows, streaming at 50k events/s, latency down ~50%. I want
      the seat where discovery, prototype, and production are the same job, then
      the pattern gets written down so the next deploy is faster.
    </p>
    <p>
      <a href={site.resume}>Resume</a>
      ·
      <a href={site.linkedin}>LinkedIn</a>
      ·
      <a href={site.github}>GitHub</a>
      ·
      <a href={`mailto:${site.email}`}>{site.email}</a>
    </p>
  </section>

  <hr class="my-14 border-0 border-t border-rule" />

  <section>
    <h2 class="text-sm font-medium tracking-wide text-mute">History</h2>
    <ul class="mt-8 space-y-6">
      {
        timeline.map((row) => (
          <li class="grid gap-2 sm:grid-cols-[9.5rem_1fr] sm:gap-8">
            <p class="mono text-sm text-mute">{row.era}</p>
            <p class="leading-7" set:html={row.body} />
          </li>
        ))
      }
    </ul>
  </section>

  <hr class="my-14 border-0 border-t border-rule" />

  <section>
    <h2 class="text-sm font-medium tracking-wide text-mute">Now</h2>
    <p class="mt-6 leading-7">
      Shipping TechPrufer in public, embedding with brokers at ANAX, and writing
      the operator loop as I go: discover, prototype, productionize, then
      codify. Based in India. Open to relocate for a forward-deployed / AI
      deployment seat.
    </p>
  </section>

  <hr class="my-14 border-0 border-t border-rule" />

  <section>
    <h2 class="text-sm font-medium tracking-wide text-mute">
      Recent GitHub activity
    </h2>
    {
      prs.length === 0 ? (
        <p class="mt-6 text-mute">
          No public pull requests to list on this build. See
          <a href={site.github}>{site.githubUser}</a>.
        </p>
      ) : (
        <ul class="mt-8 space-y-3">
          {prs.map((pr) => (
            <li class="grid gap-1 sm:grid-cols-[5rem_1fr] sm:gap-6">
              <span class="mono text-sm text-mute">{pr.state}</span>
              <a href={pr.url}>
                <span class="mono text-sm text-mute">{pr.repo}</span>
                <span class="ml-2">{pr.title}</span>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </section>

  <hr class="my-14 border-0 border-t border-rule" />

  <footer>
    <h2 class="text-sm font-medium tracking-wide text-mute">Get in touch</h2>
    <p class="mt-6 leading-7">
      <a href={`mailto:${site.email}`}>{site.email}</a>
      ·
      <a href={site.linkedin}>LinkedIn</a>
      ·
      <a href={site.github}>GitHub</a>
    </p>
    <p class="mono mt-10 text-xs text-mute">
      adhikram.com · static Astro · rebuilt on each git push
    </p>
  </footer>
</Layout>
