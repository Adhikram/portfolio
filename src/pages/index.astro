---
import Layout from "../layouts/Layout.astro";
import ProductCard from "../components/ProductCard.astro";
import { site, loop, products } from "../data/site";
import { fetchRecentPullRequests } from "../lib/github";

const prs = await fetchRecentPullRequests(
  site.githubUser,
  process.env.GITHUB_TOKEN,
);

const featured = products.filter((p) => p.featured);
const rest = products.filter((p) => !p.featured);
---

<Layout>
  <section id="top" class="scroll-mt-24">
    <p class="mono text-sm tracking-wide text-mute">
      Founding engineer · founder · data platforms
    </p>
    <h1 class="mt-4 max-w-3xl text-3xl font-medium leading-tight tracking-tight sm:text-4xl">
      I ship production GenAI with operators.
    </h1>
    <p class="mt-6 max-w-2xl text-lg leading-8 text-ink/90">
      Hey, I am Adhikram. I embed with the people who run the workflow, then
      take agents and RAG from a messy desk to something that moves a number:
      deal flow, latency, or MRR.
    </p>
    <p class="mt-4 max-w-2xl leading-7 text-mute">
      Right now: founding engineer at
      <a href="https://anaxrep.com/">ANAX</a>, and
      <a href="https://techprufer.com/">TechPrufer</a>
      as the public side product. Based in India. Open to relocate for a
      forward-deployed / AI deployment seat.
    </p>
    <p class="mt-6 flex flex-wrap gap-x-4 gap-y-2">
      <a href={site.resume}>Resume</a>
      <a href={site.linkedin}>LinkedIn</a>
      <a href={site.github}>GitHub</a>
      <a href={`mailto:${site.email}`}>Email</a>
    </p>
  </section>

  <section
    id="loop"
    class="mt-16 scroll-mt-24 border-t border-rule pt-12"
  >
    <h2 class="text-sm font-medium tracking-wide text-mute">How I work</h2>
    <p class="mt-3 max-w-2xl leading-7">
      Same loop on every product: discovery, prototype, production, then write
      it down. That is the FDE job I am optimizing for.
    </p>
    <ol class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        loop.map((step) => (
          <li class="border border-rule p-4">
            <p class="mono text-xs text-mute">{step.n}</p>
            <p class="mt-2 font-medium tracking-tight">{step.title}</p>
            <p class="mt-2 text-sm leading-6 text-mute">{step.body}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section id="work" class="mt-16 scroll-mt-24 border-t border-rule pt-12">
    <h2 class="text-sm font-medium tracking-wide text-mute">Products I ship</h2>
    <p class="mt-3 max-w-2xl leading-7">
      Work seats first, then products I own. Each card is a live system, not a
      stack list.
    </p>

    <div class="mt-8 grid gap-5 sm:grid-cols-2">
      {featured.map((product) => <ProductCard product={product} />)}
    </div>
    <div class="mt-5 grid gap-5 sm:grid-cols-2">
      {rest.map((product) => <ProductCard product={product} />)}
    </div>
  </section>

  <section
    id="activity"
    class="mt-16 scroll-mt-24 border-t border-rule pt-12"
  >
    <h2 class="text-sm font-medium tracking-wide text-mute">
      Recent public GitHub
    </h2>
    {
      prs.length === 0 ? (
        <p class="mt-6 text-mute">
          No public pull requests on this build. See
          <a href={site.github}>{site.githubUser}</a>.
        </p>
      ) : (
        <ul class="mt-8 divide-y divide-rule border-y border-rule">
          {prs.slice(0, 8).map((pr) => (
            <li class="grid gap-1 py-3 sm:grid-cols-[5.5rem_1fr] sm:gap-6">
              <span class="mono text-sm text-mute">{pr.state}</span>
              <a href={pr.url} class="min-w-0">
                <span class="mono text-sm text-mute">{pr.repo}</span>
                <span class="ml-2">{pr.title}</span>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </section>

  <footer
    id="contact"
    class="mt-16 scroll-mt-24 border-t border-rule pt-12"
  >
    <h2 class="text-sm font-medium tracking-wide text-mute">Get in touch</h2>
    <p class="mt-4 leading-7">
      <a href={`mailto:${site.email}`}>{site.email}</a>
      ·
      <a href={site.linkedin}>LinkedIn</a>
      ·
      <a href={site.github}>GitHub</a>
      ·
      <a href={site.resume}>Resume</a>
    </p>
    <p class="mono mt-10 text-xs text-mute">
      adhikram.com · static Astro · rebuilt on each git push
    </p>
  </footer>
</Layout>
