---
import Layout from "../../layouts/Layout.astro";
import Mark from "../../components/Mark.astro";
import { ownedProducts, site } from "../../data/site";
import { techpruferSurfaces } from "../../data/techprufer";

export function getStaticPaths() {
  return ownedProducts.map((product) => ({
    params: { id: product.id },
    props: { product },
  }));
}

const { product } = Astro.props;
const others = ownedProducts.filter((item) => item.id !== product.id);
const isTechPrufer = product.id === "techprufer";
---

<Layout
  title={`${product.name} · ${site.shortName}`}
  description={product.summary}
  image={product.picture}
>
  <article class="frame-column pt-16 pb-20 md:pt-20">
    <p class="type-label text-muted-foreground">
      <a href="/#products" class="hover:text-foreground">Products</a>
      <span class="mx-2 text-border">/</span>
      {product.name}
    </p>
    {
      product.picture ? (
        <img
          class="product-shot mt-6"
          src={product.picture}
          alt=""
          width="1200"
          height="630"
          decoding="async"
        />
      ) : null
    }
    <div class="mt-6 flex flex-wrap items-center justify-between gap-3">
      <div class="flex min-w-0 items-center gap-3">
        <img class="work-logo" src={product.logo} alt="" width="40" height="40" decoding="async" />
        <h1 class="type-display">{product.name}</h1>
      </div>
      <p class="type-meta text-muted-foreground">{product.kindLabel} · {product.period}</p>
    </div>
    <p class="mt-4 text-[19px] leading-relaxed text-muted-strong">{product.role}</p>
    <div class="prose-reading mt-6 max-w-2xl">
      {product.detail.map((para) => <p>{para}</p>)}
    </div>

    <dl class="mt-10 grid grid-cols-2 gap-4 border-y border-rule py-6 sm:grid-cols-3">
      {
        product.metrics.map((m) => (
          <div>
            <dt class="font-mono text-lg">{m.value}</dt>
            <dd class="mt-1 text-sm text-muted-foreground">{m.label}</dd>
          </div>
        ))
      }
    </dl>

    <h2 class="type-label mt-10 text-muted-foreground">Shipped</h2>
    <ul class="mt-4 space-y-2 text-[17px] leading-7 text-muted-strong">
      {
        product.shipped.map((line) => (
          <li class="pl-3 before:mr-2 before:text-muted-foreground before:content-['-']">
            {line}
          </li>
        ))
      }
    </ul>

    <h2 class="type-label mt-10 text-muted-foreground">Stack</h2>
    <div class="mt-3 flex flex-wrap gap-1.5">
      {product.stack.map((tag) => (
        <span class="chip">
          <Mark name={tag} />
          {tag}
        </span>
      ))}
    </div>

    {
      isTechPrufer ? (
        <section class="mt-16 border-t border-rule pt-10">
          <h2 class="type-label text-muted-foreground">Feature trail</h2>
          <p class="mt-3 max-w-2xl text-sm leading-6 text-muted-foreground">
            The product pages I wrote for TechPrufer, in the order people walk them. Company feature trails first, then the workspace.
          </p>
          <ol class="relative ml-1 mt-8 space-y-6 border-l border-border pl-6">
            {techpruferSurfaces.map((surface, index) => (
              <li class="relative">
                <span
                  aria-hidden="true"
                  class="absolute top-2 left-[-28.5px] size-2 rounded-full border border-border bg-brand"
                />
                <a
                  class="group block rounded-xl border border-border bg-card p-4 hover:border-brand/40"
                  href={`/products/techprufer/${surface.slug}`}
                >
                  <p class="type-meta text-muted-foreground">
                    {String(index + 1).padStart(2, "0")} · {surface.label}
                  </p>
                  <h3 class="type-item-title mt-1 group-hover:text-brand">{surface.headline}</h3>
                  <p class="mt-2 text-sm leading-6 text-muted-foreground">{surface.summary}</p>
                  <p class="type-meta mt-3 text-brand">Open the trail →</p>
                </a>
              </li>
            ))}
          </ol>
        </section>
      ) : null
    }

    {
      product.url ? (
        <p class="mt-10">
          <a class="btn btn-accent" href={product.url} target="_blank" rel="noopener noreferrer">
            Visit {product.name} ↗
          </a>
        </p>
      ) : null
    }

    {
      others.length > 0 ? (
        <section class="mt-16 border-t border-rule pt-10">
          <h2 class="type-label text-muted-foreground">Other products</h2>
          <ul class="mt-5 space-y-3">
            {others.map((item) => (
              <li>
                <button
                  type="button"
                  class="group block w-full rounded-xl border border-border bg-card p-4 text-left"
                  data-open-train={item.id}
                >
                  <div class="flex flex-wrap items-center justify-between gap-2">
                    <span class="inline-flex items-center gap-2 type-item-title group-hover:text-brand">
                      <img class="work-logo" src={item.logo} alt="" width="40" height="40" loading="lazy" decoding="async" />
                      {item.name}
                    </span>
                    <span class="type-meta text-muted-foreground">{item.kindLabel}</span>
                  </div>
                  <p class="mt-2 text-sm leading-6 text-muted-foreground">{item.summary}</p>
                </button>
              </li>
            ))}
          </ul>
        </section>
      ) : null
    }
  </article>
</Layout>
